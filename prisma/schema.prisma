generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  user
  bot
}

enum AccountRole {
  user
  mod
  admin
}

enum NotificationType {
  friend_request
  friend_accept
  message
  mention
  comment_reply
  report_new
  report_update
}

enum ReportStatus {
  open
  closed
}

enum DmPolicy {
  everyone
  friends
  noone
}

enum PostType {
  discussion
  lesson
  quiz
  reading
  listening
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum LessonType {
  reading
  listening
}

model Account {
  id          String      @id @default(cuid())
  username    String      @unique
  displayName String
  bio         String?
  avatarUrl   String?
  accountType AccountType @default(user)
  role        AccountRole @default(user)
  verified    Boolean     @default(false)
  dmPolicy    DmPolicy    @default(everyone)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auth      UserAuth?
  botConfig BotConfig?

  posts    Post[]
  comments Comment[]
  votes    Vote[]
  messages Message[]

  // ✅ Lesson.createdBy opposite relation
  createdLessons Lesson[] @relation("LessonCreatedBy")

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  conversationMembers ConversationMember[]
  progress            Progress[]

  // Reports
  reports         Report[] @relation("ReportReporter")
  reviewedReports Report[] @relation("ReportReviewedBy")

  // Subscriptions
  subscriptions HubSubscription[]

  // Notifications
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsFrom Notification[] @relation("NotificationActor")
}

model UserAuth {
  accountId    String  @id
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email        String  @unique
  passwordHash String
}

model BotConfig {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  systemPrompt   String
  allowedActions Json
  modelPolicy    Json

  dailyPostLimit Int @default(5)
  dmDailyLimit   Int @default(50)
}

model Hub {
  id          String  @id @default(cuid())
  langCode    String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())

  posts         Post[]
  lessons       Lesson[]
  subscriptions HubSubscription[]
}

model HubSubscription {
  id        String   @id @default(cuid())
  accountId String
  hubId     String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hub     Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([accountId, hubId])
  @@index([hubId])
  @@index([accountId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  accountId String
  actorId   String?
  type      NotificationType
  title     String
  body      String?
  url       String?
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  account Account  @relation("NotificationRecipient", fields: [accountId], references: [id], onDelete: Cascade)
  actor   Account? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([accountId, readAt])
}

model Post {
  id    String @id @default(cuid())
  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id], onDelete: Cascade)

  authorId String
  author   Account @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type    PostType @default(discussion)
  title   String
  content Json

  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  votes    Vote[]

  @@index([hubId, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   Account @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentParent")

  body      String
  score     Int      @default(0)
  createdAt DateTime @default(now())

  votes Vote[]

  @@index([postId, createdAt])
}

model Vote {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  value     Int
  createdAt DateTime @default(now())

  @@unique([accountId, postId])
  @@unique([accountId, commentId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)

  requester Account @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Account @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  type      String   @default("direct")
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String @id @default(cuid())
  conversationId String
  accountId      String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([conversationId, accountId])
  @@index([accountId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Account      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Lesson {
  id    String @id @default(cuid())
  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id], onDelete: Cascade)

  type    LessonType
  level   String
  title   String
  content Json

  createdById String
  createdBy   Account @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  publishedAt DateTime @default(now())

  progress Progress[]

  @@index([hubId, type, publishedAt])
}

model Progress {
  id         String   @id @default(cuid())
  accountId  String
  lessonId   String
  score      Int      @default(0)
  lastSeenAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([accountId, lessonId])
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String

  status       ReportStatus @default(open)
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())

  reporter   Account  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy Account? @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status, createdAt])
}
